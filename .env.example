# ==============================================================================
# House Untold — Production Environment Configuration (.env)
# Target: Render / Railway / Production VM
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core & Environment
# ------------------------------------------------------------------------------
APP_ENV=production
PORT=8080
APP_URL=https://houseuntold.pages.dev
PUBLIC_API_URL=https://houseuntold-backend.onrender.com

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection (Neon or Supabase)
# Must include sslmode=require.
# NEON: Use the DIRECT connection string (without '-pooler' in host) to support advisory locks!
# SUPABASE: Use direct port 5432 (not transaction pooler port 6543)!
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Connection Pool Tuning (Optimized for 100+ req/sec on free/starter tiers)
DB_MAX_CONNS=15
DB_MIN_CONNS=4
DB_QUERY_TIMEOUT=3s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Automatic Schema Migrations on Startup (Uses PostgreSQL Advisory Lock 987654321)
RUN_MIGRATIONS_ON_START=true
MIGRATIONS_DIR=db/migrations

# ------------------------------------------------------------------------------
# 3. Cryptographic Secrets (MUST be at least 32 characters in production)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=GenerateAtLeast32CharsSecretKeyForAccessTokens123
JWT_REFRESH_SECRET=GenerateDifferent32CharsSecretKeyForRefreshTokens123
QR_SIGNING_SECRET=GenerateAtLeast32CharsSecretKeyForGateQRTokens123

JWT_ISSUER=houseuntold-api
JWT_AUDIENCE=houseuntold-staff
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL=720h
TICKET_QR_TTL=24h

# ------------------------------------------------------------------------------
# 4. CORS & Cookie Policy
# Explicit domain of Cloudflare Pages frontend (NO wildcard * allowed in production)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://houseuntold.pages.dev
COOKIE_DOMAIN=
COOKIE_SECURE=true
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# 5. Direct UPI QR Payment Configuration (No Razorpay/Third-party Gateway)
# ------------------------------------------------------------------------------
UPI_VPA=houseuntold@upi
UPI_MERCHANT_NAME=House Untold Live Events
UPI_QR_IMAGE_URL=

# ------------------------------------------------------------------------------
# 6. Meta WhatsApp Cloud API (Optional - Ticket pass delivery to patrons)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APIVersion=v21.0
WHATSAPP_WORKERS=4
WHATSAPP_HTTP_TIMEOUT=10s

# ------------------------------------------------------------------------------
# 7. High-Concurrency Rate Limiting (Postgres + In-Memory LRU Cache)
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_CHECKOUT_MAX=60
RATE_LIMIT_CHECKOUT_WINDOW=1m
RATE_LIMIT_SCAN_MAX=300
RATE_LIMIT_SCAN_WINDOW=1m
RATE_LIMIT_BAR_MAX=300
RATE_LIMIT_BAR_WINDOW=1m
RATE_LIMIT_CACHE_SIZE=16384
RATE_LIMIT_FLUSH_EVERY=100

# ------------------------------------------------------------------------------
# 8. Server Timeouts & Shutdown
# ------------------------------------------------------------------------------
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s
