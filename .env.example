# ==============================================================================
# House Untold — Production Environment Configuration (.env.example)
# Target: Railway / Render / Production VM
# ==============================================================================

APP_ENV=production
PORT=8080
APP_URL=https://houseuntold.pages.dev
PUBLIC_API_URL=https://houseuntold-backend.up.railway.app

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (Neon Lakebase Postgres)
# Direct connection (without -pooler) is ideal, but the backend automatically
# handles -pooler strings and Neon scale-to-zero cold starts.
# Must include sslmode=require.
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://neondb_owner:<PASSWORD>@<ENDPOINT>.neon.tech/neondb?sslmode=require

# Connection Pool Tuning
DB_MAX_CONNS=15
DB_MIN_CONNS=4
DB_QUERY_TIMEOUT=3s
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Automatic Schema Migrations on Startup
RUN_MIGRATIONS_ON_START=true
MIGRATIONS_DIR=db/migrations

# Cryptographic Secrets (MUST be at least 32 characters in production)
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-random-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-chars-random-refresh-secret
QR_SIGNING_SECRET=replace-with-at-least-32-chars-random-qr-signing-secret

JWT_ISSUER=houseuntold
JWT_AUDIENCE=houseuntold-staff
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL=720h
TICKET_QR_TTL=24h

# CORS & Cookie Policy (Exact frontend domain, comma-separated if multiple)
ALLOWED_ORIGINS=https://houseuntold.pages.dev
COOKIE_SECURE=true
COOKIE_DOMAIN=
TRUSTED_PROXIES=

# Direct UPI QR Payment
UPI_VPA=houseuntold@upi
UPI_MERCHANT_NAME=House Untold Live Events

# Metrics
METRICS_TOKEN=replace-with-random-metrics-token
